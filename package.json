{
  "name": "crmini",
  "version": "0.1.0",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prepare:standalone": "node scripts/prepare-standalone.cjs",
    "check:electron-abi": "node scripts/check-electron-abi.cjs",
    "desktop:build": "npm run build && npm run prepare:standalone",
    "desktop": "npm run desktop:build && npm run check:electron-abi && electron electron/main.cjs",
    "desktop:dev": "electron electron/main.cjs --dev",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md,yml,yaml,mjs,cjs,mts}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md,yml,yaml,mjs,cjs,mts}\"",
    "test": "vitest run",
    "test:components": "vitest run",
    "db:seed": "node database/seed.mjs",
    "db:migrate": "node database/migrate.cjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.3.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "^5.0.0",
    "vitest": "^5.0.4"
  }
}
